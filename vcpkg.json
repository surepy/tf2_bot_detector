{
  "name": "tf2-bot-detector",
  "version-string": "",
  "dependencies": [
    "sdl2",
    {
      "name": "sdl2",
      "features": [ "wayland", "x11", "vulkan" ],
      "platform": "linux"
    },
    {
      "name": "cryptopp",
      "version>=": "2026-03-02"
    },
    {
      "name": "libzippp",
      "version>=": "6.1-1.9.2"
    },
    {
      "name": "fmt",
      "version>=": "10.2.1"
    },
    {
      "name": "discord-game-sdk",
      "platform": "!static"
    },
    {
      "name": "stb",
      "version>=": "2023-04-11#1"
    },
    "nlohmann-json",
    {
		  "name": "catch2",
		  "version>=": "3.3.0"
    },
    "sqlitecpp",
    {
      "name": "curl",
      "version>=": "8.20.0",
      "default-features": false,
      "features": [
        "ssl",
        "brotli"
      ]
    },
    {
      "$comment": "curl's CMake integration needs Brotli's unsuffixed library targets.",
